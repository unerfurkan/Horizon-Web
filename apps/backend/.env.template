STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# --- iyzico (leave the keys empty to run without iyzico) ---
# Sandbox keys come from the iyzico sandbox merchant panel.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# "tr" or "en" - language of the iyzico payment page
IYZICO_LOCALE=tr
# Public HTTPS URL of this backend (use a tunnel such as ngrok/cloudflared locally).
# iyzico sends the customer back here after paying.
BACKEND_PUBLIC_URL=
# Storefront origin. Customers are only ever redirected to this origin.
STOREFRONT_URL=http://localhost:8000
# Used when a customer gave no ID number / phone (iyzico requires both). Sandbox accepts test values.
IYZICO_FALLBACK_IDENTITY_NUMBER=11111111111
IYZICO_FALLBACK_GSM_NUMBER=+905000000000
